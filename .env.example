# Copie este arquivo para .env e preencha os valores
DISCORD_TOKEN=SEU_TOKEN_AQUI

# Parâmetros opcionais do modelo
# Se não definidos, usa os valores padrão de config.py
LLM_MODEL_PATH=models/texto/WeirdCompound-v1.7-24b-absolute-heresy.i1-Q4_K_M.gguf
LLM_N_CTX=4096
LLM_MAX_TOKENS=220
LLM_N_GPU_LAYERS=-1
LLM_N_BATCH=1024
LLM_N_UBATCH=256
# Ajuste opcional: deixe vazio para usar automático.
# LLM_N_THREADS=8
# LLM_N_THREADS_BATCH=16
LLM_VOZ_MAX_TOKENS=64
LLM_KV_TYPE=q8_0
LLM_CHAT_TEMPLATE=chatml

# llama.cpp oficial baixado pelo instalar.bat
LLAMA_CPP_DIR=llama.cpp
LLAMA_CPP_SERVER_EXE=llama.cpp/llama-server.exe
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_STARTUP_TIMEOUT=600
LLAMA_REQUEST_TIMEOUT=600

# Chatterbox Multilingual V3 PT-BR local.
CHATTERBOX_BASE_DIR=models/chatterbox/base
CHATTERBOX_PTBR_DIR=models/chatterbox/pt-br
CHATTERBOX_DEVICE=cuda
CHATTERBOX_MAX_CHARS=280

# Controle de repetição e estilo (ajuste conforme necessário)
LLM_TEMPERATURE=0.8
LLM_MIN_P=0.05
LLM_TOP_P=1.0
LLM_TOP_K=0
LLM_DRY_MULTIPLIER=0.8
LLM_DRY_ALLOWED_LENGTH=3
LLM_REPEAT_PENALTY=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
